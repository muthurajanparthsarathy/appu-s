# /var/www/appus-mart/.env on the server. Never commit the real file.
CATALOG_SOURCE=database
# A NEW database just for Appu's Mart (see DEPLOY.md). Never reuse another app's database or credentials.
DATABASE_URL=postgresql://appus_mart:CHANGE_ME@127.0.0.1:5432/appus_mart
APP_URL=https://shop.example.com
TRUSTED_PROXY_COUNT=1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_long_random
CRON_SECRET=CHANGE_ME_long_random
# Leave empty for cash on delivery only; Appu's Mart's own Razorpay keys go here later.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
