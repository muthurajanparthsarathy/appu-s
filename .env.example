# Copy to .env. Demo mode needs nothing else: CATALOG_SOURCE=demo (or unset) browses the built-in catalog,
# and accounts/checkout/admin show a "needs the database" notice.
# Use a NEW database for VeenaMart only — never another project's database or credentials.
CATALOG_SOURCE=demo

# Database mode: set CATALOG_SOURCE=database and point this at a VeenaMart PostgreSQL database.
# `npm run db:local:init` creates a private local PostgreSQL and writes this line for you.
DATABASE_URL=postgresql://veenamart:change-me@localhost:5433/veenamart

# Public base URL (used for same-origin checks behind proxies).
APP_URL=http://localhost:3001
# Number of reverse proxies in front of the app that append to X-Forwarded-For (for IP-based rate limits).
TRUSTED_PROXY_COUNT=1

# Admin account created by `npm run db:seed` if it does not exist yet (password is never overwritten).
ADMIN_EMAIL=admin@veenamart.test
ADMIN_PASSWORD=

# Bearer token for GET /api/cron/release-reservations (schedule every 5 minutes in production).
CRON_SECRET=

# Razorpay — leave empty to offer cash on delivery only. Use VeenaMart's OWN keys
# (rzp_test_ keys in development; rzp_live_ keys are ignored outside production builds).
# Webhook URL: https://<your-domain>/api/payments/razorpay/webhook  events: payment.captured, order.paid, payment.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
